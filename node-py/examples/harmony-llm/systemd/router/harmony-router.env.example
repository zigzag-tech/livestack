# ~/.config/harmony-router/env  (rendered by scripts/harmony-router-rollout.sh)
#
# The fleet broker of THIS machine's region: na -> the tower's fleetd, cn -> the
# cn fleetd on zz-tower2. The router ranks the fleet from this region's vantage.
HARMONY_LLM_FLEET_URL=http://100.64.0.18:8801
LIVESTACK_NODE_REGION=na
# Loopback only: the router is for this machine's own callers.
HARMONY_ROUTER_HOST=127.0.0.1
HARMONY_ROUTER_PORT=8188
HARMONY_ROUTER_ID=router-HOSTNAME
# Route records (what this router placed, joined to the target's demand record by
# request id). Unset disables the log.
HARMONY_DEMAND_LOG_AGE_DAYS=21
# Deliberately absent: HARMONY_LLM_FLEET_TOKEN. The router holds no fleet credential.
