# A regional FLEET broker (observe-only), for a region whose routers should not
# fetch `/fleet` across the ocean: `cn` on zz-tower2 (the `na` one is
# livestack-fleetd on xc-tower-ubuntu). Same code as every other broker, run from
# the router's pinned source and venv (scripts/harmony-router-rollout.sh --fleetd).
#
# OBSERVE ONLY, by LIVESTACK_DISPATCH=observe: it plans nothing and warms,
# evicts and reclaims nothing -- a host broker is the only residency authority.
# Nodes are SEEDS (LIVESTACK_PEERS) because the nodes announce to their own
# region's broker; a node this broker cannot reach is `mia` in its view and is
# simply not a candidate here.
[Unit]
Description=Livestack regional FLEET broker (observe-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/harmony-router/fleetd.env
Environment=PYTHONPATH=%h/.local/share/harmony-router/src/node-py
Environment=LIVESTACK_DISPATCH=observe
Environment=LIVESTACK_BROKER_PORT=8801
Environment=LIVESTACK_REPLAN_INTERVAL=15
# Cross-region probes take 0.5-1.5 s and DERP hiccups are routine: do not flap.
Environment=LIVESTACK_PEER_SUSPECT_SECONDS=60
Environment=LIVESTACK_PEER_MIA_SECONDS=900
WorkingDirectory=%h/.local/share/harmony-router/src/node-py
ExecStart=%h/.local/share/harmony-router/venv/bin/python -m livestack_node.hostd
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
