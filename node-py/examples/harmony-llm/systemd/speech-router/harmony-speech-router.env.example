# Harmony speech router (zz-tower2-cn): loopback ingress for the relay target harmony-asr.
HARMONY_LLM_FLEET_URL=http://100.64.0.18:8801
LIVESTACK_NODE_REGION=cn
HARMONY_ROUTER_HOST=127.0.0.1
HARMONY_ROUTER_PORT=8189
HARMONY_ROUTER_ID=router-zz-tower2-speech
HARMONY_ROUTER_HEALTH_KIND=polyasr
HARMONY_ROUTER_REV=c7ef92a0
# Decision/route logs: bounded by size x files and an age window; enforcer: livestack_node.ledger.JsonlLedger
HARMONY_DEMAND_LOG_DIR=/home/ubuntu/.cache/livestack/demand-speech
HARMONY_DEMAND_LOG_AGE_DAYS=14
HARMONY_DEMAND_LOG_MAX_MB=32
HARMONY_DEMAND_LOG_FILES=4
# Deliberately absent: any fleet token (the router holds no credential).
HARMONY_ROUTER_VIEW_REFRESH_S=5
HARMONY_ROUTER_VIEW_TIMEOUT_S=10
